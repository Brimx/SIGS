<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Supermercado.GUI"
             xmlns:semi="using:Semi.Avalonia"
             xmlns:semiDataGrid="using:Semi.Avalonia.DataGrid"
             xmlns:dialogHost="using:DialogHostAvalonia"
             x:Class="Supermercado.GUI.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Supermercado.GUI/Resources/Primitives.axaml" />
                <ResourceInclude Source="avares://Supermercado.GUI/Resources/Geometry.axaml" />
                <ResourceInclude Source="avares://Supermercado.GUI/Resources/Typography.axaml" />
                <ResourceInclude Source="avares://Supermercado.GUI/Resources/Semantic.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="es-ES" />
        <semiDataGrid:DataGridSemiTheme />
        <dialogHost:DialogHostStyles />
    </Application.Styles>
</Application>
