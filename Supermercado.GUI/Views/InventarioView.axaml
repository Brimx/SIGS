<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Supermercado.GUI.ViewModels"
             xmlns:finanzas="using:Supermercado.Entidades.Finanzas"
             xmlns:productos="using:Supermercado.Entidades.Productos"
             x:Class="Supermercado.GUI.Views.InventarioView"
             x:DataType="vm:InventarioViewModel"
             FontFamily="{StaticResource FontFamilyPlex}">

    <Panel>
        <Grid RowDefinitions="Auto,16,*,12,Auto" Margin="16">

            <!-- Barra Superior de Filtros y KPIs de Inventario -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="16,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox
                             Text="{Binding FiltroTexto}"
                             PlaceholderText="Filtrar por código de barras, nombre de producto o número de lote..."
                             MinHeight="38" Width="300" Margin="0,0,12,8" />

                    <CheckBox
                              IsChecked="{Binding SoloStockBajo}"
                              VerticalAlignment="Center" Margin="0,0,12,8">
                        <TextBlock Text="{Binding AlertasStockBajoCount, StringFormat='Solo Stock Bajo ({0})'}"
                                   FontWeight="{StaticResource FontWeightMedium}" />
                    </CheckBox>

                    <CheckBox
                              IsChecked="{Binding SoloProximosAVencer}"
                              VerticalAlignment="Center" Margin="0,0,12,8">
                        <TextBlock Text="{Binding LotesPorVencerCount, StringFormat='Próximos a Vencer ({0})'}"
                                   FontWeight="{StaticResource FontWeightMedium}" />
                    </CheckBox>

                    <Button
                            Command="{Binding AbrirModalMermaCommand}"
                            MinHeight="38" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource BrushWarningText}" />
                            <TextBlock Text="Baja por Merma" FontWeight="{StaticResource FontWeightSemiBold}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AbrirModalNuevoProductoCommand}"
                            IsVisible="{Binding PuedeGestionarInventario}"
                            MinHeight="38" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="Plus" Size="16" />
                            <TextBlock Text="Nuevo producto" FontWeight="{StaticResource FontWeightSemiBold}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AbrirModalEntradaBodegaCommand}"
                            IsVisible="{Binding PuedeGestionarInventario}"
                            MinHeight="38" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="Boxes" Size="16" />
                            <TextBlock Text="Entrada a bodega" FontWeight="{StaticResource FontWeightSemiBold}" />
                        </StackPanel>
                    </Button>

                    <Button Click="ExportarCsv_Click"
                            MinHeight="38" Margin="0,0,8,8">
                        <TextBlock Text="Exportar CSV" />
                    </Button>

                    <Button
                            Command="{Binding ActualizarListadoCommand}"
                            Classes="Primary" Theme="{DynamicResource SolidButton}"
                            MinHeight="38" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="RefreshCw" Size="16" />
                            <TextBlock Text="Actualizar" FontWeight="{StaticResource FontWeightSemiBold}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>

            <!-- Grilla Densa de Inventario Consolidado FEFO -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    ClipToBounds="True">
                <DataGrid ItemsSource="{Binding ProductosFiltrados}"
                          SelectedItem="{Binding ItemSeleccionado}"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÓDIGO"
                                            Binding="{Binding CodigoBarras}"
                                            Width="120"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <DataGridTemplateColumn Header="PRODUCTO" Width="*" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding NombreProducto}">
                                        <LucideIcon Grid.Column="0" Kind="TriangleAlert" Size="14"
                                                    Margin="0,0,6,0"
                                                    Foreground="{DynamicResource BrushWarningText}"
                                                    IsVisible="{Binding EnAlertaStockBajo}" />
                                        <TextBlock Grid.Column="1" Text="{Binding NombreProducto}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="LOTE FEFO"
                                            Binding="{Binding NumeroLote}"
                                            Width="120"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <DataGridTextColumn Header="VENCIMIENTO"
                                            Binding="{Binding FechaVencimiento}"
                                            Width="130"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <DataGridTextColumn Header="ESTANTE"
                                            Binding="{Binding CantidadEstante}"
                                            Width="100"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <DataGridTextColumn Header="BODEGA"
                                            Binding="{Binding CantidadBodega}"
                                            Width="100"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <DataGridTextColumn Header="TOTAL"
                                            Binding="{Binding TotalStock}"
                                            Width="100"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <DataGridTextColumn Header="ESTADO"
                                            Binding="{Binding EstadoBadge}"
                                            Width="150"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Pie de Estado -->
            <Border Grid.Row="4"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSmall}"
                    Padding="12,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding MensajeEstado}"
                               FontWeight="{StaticResource FontWeightMedium}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding TotalRegistros, StringFormat='Total lotes consolidados: {0}'}"
                               FontFamily="{StaticResource FontFamilyPlexCondensed}"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Modal de Registro Legal/Contable de Baja por Merma -->
        <Border IsVisible="{Binding ModalMermaAbierto}"
                Background="{DynamicResource BrushOverlayScrim}">
            <Border Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}"
                    Width="460"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <LucideIcon Kind="TriangleAlert" Size="20" Foreground="{DynamicResource BrushWarningText}" />
                        <TextBlock Text="Baja Contable de Inventario por Merma"
                                   FontFamily="{StaticResource FontFamilyStackSans}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="{StaticResource FontWeightBold}" />
                    </StackPanel>

                    <TextBlock Text="Descuenta existencias dañadas o vencidas dejando soporte inmutable en auditoría."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextSecondary}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Cantidad a dar de baja" FontWeight="{StaticResource FontWeightMedium}" />
                        <NumericUpDown Value="{Binding CantidadMermaInput}"
                                       Minimum="1"
                                       FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Motivo / Justificación Contable" FontWeight="{StaticResource FontWeightMedium}" />
                        <TextBox Text="{Binding MotivoMermaInput}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Command="{Binding CerrarModalMermaCommand}">
                            <TextBlock Text="Cancelar" />
                        </Button>
                        <Button Command="{Binding ConfirmarMermaCommand}"
                                Classes="Warning" Theme="{DynamicResource SolidButton}">
                            <TextBlock Text="Registrar Baja Auditada" FontWeight="{StaticResource FontWeightBold}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Classes="Scrim" IsVisible="{Binding ModalNuevoProductoAbierto}">
            <Border Classes="Tarjeta"
                    MaxWidth="460" MaxHeight="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="Titulo" Text="Nuevo producto" />
                        <TextBlock Classes="Ayuda"
                                   Text="El alta queda registrada en auditoría. El producto nace sin existencias; use Entrada a bodega para recibirlo."
                                   TextWrapping="Wrap" />

                        <StackPanel Spacing="4">
                            <TextBlock Classes="Etiqueta" Text="Código de barras" />
                            <TextBox Text="{Binding NuevoCodigoBarrasInput}"
                                     PlaceholderText="Ej. 7701234567890" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="Etiqueta" Text="Nombre" />
                            <TextBox Text="{Binding NuevoNombreInput}"
                                     PlaceholderText="Ej. Arroz Diana 1 kg" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="Etiqueta" Text="Categoría" />
                            <ComboBox ItemsSource="{Binding Categorias}"
                                      SelectedItem="{Binding CategoriaSeleccionada}"
                                      PlaceholderText="Seleccione una categoría"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type productos:Categoria}">
                                        <TextBlock Text="{Binding Nombre}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="Etiqueta" Text="Precio de venta" />
                            <NumericUpDown Value="{Binding NuevoPrecioInput}"
                                           Minimum="0" Increment="1"
                                           FormatString="N0" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="Etiqueta" Text="IVA" />
                            <ComboBox ItemsSource="{Binding Impuestos}"
                                      SelectedItem="{Binding IvaSeleccionado}"
                                      PlaceholderText="Seleccione el IVA"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type finanzas:Impuesto}">
                                        <TextBlock Text="{Binding Nombre}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="Etiqueta" Text="Stock mínimo en estante" />
                            <NumericUpDown Value="{Binding NuevoStockMinimoInput}"
                                           Minimum="0" Increment="1" />
                        </StackPanel>

                        <Border IsVisible="{Binding TieneErrorModal}"
                                Background="{DynamicResource BrushErrorSubtle}"
                                BorderBrush="{DynamicResource BrushErrorText}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="10,8">
                            <TextBlock Text="{Binding ErrorModal}"
                                       Foreground="{DynamicResource BrushErrorText}"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource FontSizeCaption}" />
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Command="{Binding CerrarModalNuevoProductoCommand}">
                                <TextBlock Text="Cancelar" />
                            </Button>
                            <Button Command="{Binding ConfirmarNuevoProductoCommand}"
                                    IsEnabled="{Binding !Guardando}"
                                    Classes="Primary" Theme="{DynamicResource SolidButton}">
                                <TextBlock Text="Guardar producto" FontWeight="{StaticResource FontWeightBold}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <Border Classes="Scrim" IsVisible="{Binding ModalEntradaBodegaAbierto}">
            <Border Classes="Tarjeta"
                    MaxWidth="460" MaxHeight="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="Titulo" Text="Entrada a bodega" />
                        <TextBlock Classes="Ayuda"
                                   Text="Crea o complementa un lote, aumenta el stock de bodega y deja movimiento y auditoría."
                                   TextWrapping="Wrap" />

                        <StackPanel Spacing="4">
                            <TextBlock Classes="Etiqueta" Text="Producto" />
                            <ComboBox ItemsSource="{Binding Productos}"
                                      SelectedItem="{Binding ProductoSeleccionado}"
                                      PlaceholderText="Seleccione un producto"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type productos:Producto}">
                                        <TextBlock Text="{Binding Nombre}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="Etiqueta" Text="Cantidad" />
                            <NumericUpDown Value="{Binding CantidadEntradaInput}"
                                           Minimum="1" Increment="1" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="Etiqueta" Text="Número de lote" />
                            <TextBox Text="{Binding NumeroLoteInput}"
                                     PlaceholderText="Ej. LOTE-2026-01" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="Etiqueta" Text="Fecha de vencimiento" />
                            <DatePicker SelectedDate="{Binding FechaVencimientoEntradaInput}" />
                        </StackPanel>

                        <Border IsVisible="{Binding TieneErrorModal}"
                                Background="{DynamicResource BrushErrorSubtle}"
                                BorderBrush="{DynamicResource BrushErrorText}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="10,8">
                            <TextBlock Text="{Binding ErrorModal}"
                                       Foreground="{DynamicResource BrushErrorText}"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource FontSizeCaption}" />
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Command="{Binding CerrarModalEntradaBodegaCommand}">
                                <TextBlock Text="Cancelar" />
                            </Button>
                            <Button Command="{Binding ConfirmarEntradaBodegaCommand}"
                                    IsEnabled="{Binding !Guardando}"
                                    Classes="Primary" Theme="{DynamicResource SolidButton}">
                                <TextBlock Text="Registrar entrada" FontWeight="{StaticResource FontWeightBold}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Panel>
</UserControl>
