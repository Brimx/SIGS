<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Supermercado.GUI.ViewModels"
             x:Class="Supermercado.GUI.Views.InventarioView"
             x:DataType="vm:InventarioViewModel"
             FontFamily="{StaticResource FontFamilyPlex}">

    <Panel>
        <Grid RowDefinitions="Auto,16,*,12,Auto" Margin="16">

            <!-- Barra Superior de Filtros y KPIs de Inventario -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="16,12">
                <Grid ColumnDefinitions="*,16,Auto,12,Auto,16,Auto,8,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding FiltroTexto}"
                             PlaceholderText="Filtrar por código de barras, nombre de producto o número de lote..."
                             MinHeight="38" />

                    <CheckBox Grid.Column="2"
                              IsChecked="{Binding SoloStockBajo}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding AlertasStockBajoCount, StringFormat='Solo Stock Bajo ({0})'}"
                                   FontWeight="{StaticResource FontWeightMedium}" />
                    </CheckBox>

                    <CheckBox Grid.Column="4"
                              IsChecked="{Binding SoloProximosAVencer}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding LotesPorVencerCount, StringFormat='Próximos a Vencer ({0})'}"
                                   FontWeight="{StaticResource FontWeightMedium}" />
                    </CheckBox>

                    <Button Grid.Column="6"
                            Command="{Binding AbrirModalMermaCommand}"
                            MinHeight="38">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource BrushWarning}" />
                            <TextBlock Text="Baja por Merma" FontWeight="{StaticResource FontWeightSemiBold}" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="8"
                            Command="{Binding ActualizarListadoCommand}"
                            Background="{DynamicResource BrushPrimary}"
                            Foreground="{DynamicResource BrushTextOnPrimary}"
                            MinHeight="38">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="RefreshCw" Size="16" />
                            <TextBlock Text="Actualizar" FontWeight="{StaticResource FontWeightSemiBold}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Grilla Densa de Inventario Consolidado FEFO -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    ClipToBounds="True">
                <DataGrid ItemsSource="{Binding ProductosFiltrados}"
                          SelectedItem="{Binding ItemSeleccionado}"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÓDIGO"
                                            Binding="{Binding CodigoBarras}"
                                            Width="120"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <DataGridTextColumn Header="PRODUCTO"
                                            Binding="{Binding NombreProducto}"
                                            Width="*" />
                        <DataGridTextColumn Header="LOTE FEFO"
                                            Binding="{Binding NumeroLote}"
                                            Width="120"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <DataGridTextColumn Header="VENCIMIENTO"
                                            Binding="{Binding FechaVencimiento}"
                                            Width="130"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <DataGridTextColumn Header="ESTANTE"
                                            Binding="{Binding CantidadEstante}"
                                            Width="100"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <DataGridTextColumn Header="BODEGA"
                                            Binding="{Binding CantidadBodega}"
                                            Width="100"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <DataGridTextColumn Header="TOTAL"
                                            Binding="{Binding TotalStock}"
                                            Width="100"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <DataGridTextColumn Header="ESTADO"
                                            Binding="{Binding EstadoBadge}"
                                            Width="150"
                                            FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Pie de Estado -->
            <Border Grid.Row="4"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSmall}"
                    Padding="12,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding MensajeEstado}"
                               FontWeight="{StaticResource FontWeightMedium}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding TotalRegistros, StringFormat='Total lotes consolidados: {0}'}"
                               FontFamily="{StaticResource FontFamilyPlexCondensed}"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Modal de Registro Legal/Contable de Baja por Merma -->
        <Border IsVisible="{Binding ModalMermaAbierto}"
                Background="#99020617">
            <Border Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}"
                    Width="460"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <LucideIcon Kind="TriangleAlert" Size="20" Foreground="{DynamicResource BrushWarning}" />
                        <TextBlock Text="Baja Contable de Inventario por Merma"
                                   FontFamily="{StaticResource FontFamilyStackSans}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="{StaticResource FontWeightBold}" />
                    </StackPanel>

                    <TextBlock Text="Descuenta existencias dañadas o vencidas dejando soporte inmutable en auditoría."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextSecondary}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Cantidad a dar de baja" FontWeight="{StaticResource FontWeightMedium}" />
                        <NumericUpDown Value="{Binding CantidadMermaInput}"
                                       Minimum="1"
                                       FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Motivo / Justificación Contable" FontWeight="{StaticResource FontWeightMedium}" />
                        <TextBox Text="{Binding MotivoMermaInput}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Command="{Binding CerrarModalMermaCommand}">
                            <TextBlock Text="Cancelar" />
                        </Button>
                        <Button Command="{Binding ConfirmarMermaCommand}"
                                Background="{DynamicResource BrushWarning}"
                                Foreground="#FFFFFF">
                            <TextBlock Text="Registrar Baja Auditada" FontWeight="{StaticResource FontWeightBold}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
