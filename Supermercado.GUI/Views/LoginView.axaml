<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Supermercado.GUI.ViewModels"
             x:Class="Supermercado.GUI.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{DynamicResource BrushBackground}"
             FontFamily="{StaticResource FontFamilyPlex}">

    <Grid ColumnDefinitions="*,480,*">
        <Border Grid.Column="1"
                VerticalAlignment="Center"
                Margin="16"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLarge}"
                BoxShadow="{StaticResource ShadowElevation2}"
                Padding="32">
            <StackPanel Spacing="18">
                <!-- Cabecera de Identidad de Marca -->
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource BrushPrimarySubtle}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Width="48" Height="48"
                            HorizontalAlignment="Center">
                        <LucideIcon Kind="Store"
                                    Size="24"
                                    Foreground="{DynamicResource BrushPrimary}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="SIGS · POS &amp; Gestión"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource FontFamilyStackSans}"
                               FontSize="{StaticResource FontSizeHeadline}"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="Sistema Integral de Gestión de Supermercado · DIAN POS"
                               HorizontalAlignment="Center"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>

                <Separator Background="{DynamicResource BrushBorderSubtle}" Height="1" />

                <!-- Formulario de Credenciales -->
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Usuario / Código de Operador"
                                   FontWeight="{StaticResource FontWeightMedium}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBox Text="{Binding NombreUsuario}"
                                 PlaceholderText="Nombre de usuario o código de empleado"
                                 MinHeight="40" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding !ModoPin}">
                        <TextBlock Text="Contraseña"
                                   FontWeight="{StaticResource FontWeightMedium}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBox Text="{Binding Clave}"
                                 PasswordChar="•"
                                 PlaceholderText="Ingresa tu clave de acceso"
                                 MinHeight="40" />
                    </StackPanel>

                    <!-- Modo PIN Rápido con Teclado Numérico Táctil (Touch / POS) -->
                    <StackPanel Spacing="10" IsVisible="{Binding ModoPin}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="PIN Numérico de Caja (4 a 6 dígitos)"
                                       FontWeight="{StaticResource FontWeightMedium}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBox Text="{Binding PinAcceso}"
                                     PasswordChar="•"
                                     PlaceholderText="••••"
                                     HorizontalContentAlignment="Center"
                                     FontFamily="{StaticResource FontFamilyPlexCondensed}"
                                     FontSize="{StaticResource FontSizeHeadline}"
                                     FontWeight="{StaticResource FontWeightBold}"
                                     MinHeight="44" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,8,*,8,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                            <Button Grid.Row="0" Grid.Column="0" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44">
                                <TextBlock Text="1" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeTitle}" FontWeight="{StaticResource FontWeightBold}" />
                            </Button>
                            <Button Grid.Row="0" Grid.Column="2" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44">
                                <TextBlock Text="2" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeTitle}" FontWeight="{StaticResource FontWeightBold}" />
                            </Button>
                            <Button Grid.Row="0" Grid.Column="4" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44">
                                <TextBlock Text="3" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeTitle}" FontWeight="{StaticResource FontWeightBold}" />
                            </Button>

                            <Button Grid.Row="2" Grid.Column="0" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44">
                                <TextBlock Text="4" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeTitle}" FontWeight="{StaticResource FontWeightBold}" />
                            </Button>
                            <Button Grid.Row="2" Grid.Column="2" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44">
                                <TextBlock Text="5" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeTitle}" FontWeight="{StaticResource FontWeightBold}" />
                            </Button>
                            <Button Grid.Row="2" Grid.Column="4" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44">
                                <TextBlock Text="6" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeTitle}" FontWeight="{StaticResource FontWeightBold}" />
                            </Button>

                            <Button Grid.Row="4" Grid.Column="0" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44">
                                <TextBlock Text="7" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeTitle}" FontWeight="{StaticResource FontWeightBold}" />
                            </Button>
                            <Button Grid.Row="4" Grid.Column="2" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44">
                                <TextBlock Text="8" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeTitle}" FontWeight="{StaticResource FontWeightBold}" />
                            </Button>
                            <Button Grid.Row="4" Grid.Column="4" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44">
                                <TextBlock Text="9" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeTitle}" FontWeight="{StaticResource FontWeightBold}" />
                            </Button>

                            <Button Grid.Row="6" Grid.Column="0" Command="{Binding LimpiarPinCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" ToolTip.Tip="Limpiar PIN">
                                <TextBlock Text="C" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="{StaticResource FontWeightBold}" Foreground="{DynamicResource BrushError}" />
                            </Button>
                            <Button Grid.Row="6" Grid.Column="2" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44">
                                <TextBlock Text="0" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeTitle}" FontWeight="{StaticResource FontWeightBold}" />
                            </Button>
                            <Button Grid.Row="6" Grid.Column="4" Command="{Binding BorrarDigitoPinCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" ToolTip.Tip="Borrar último dígito">
                                <LucideIcon Kind="Delete" Size="18" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Alerta de Error -->
                    <Border IsVisible="{Binding TieneError}"
                            Background="{DynamicResource BrushErrorSubtle}"
                            BorderBrush="{DynamicResource BrushError}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <LucideIcon Kind="CircleAlert" Size="16" Foreground="{DynamicResource BrushError}" />
                            <TextBlock Text="{Binding MensajeError}"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="{StaticResource FontWeightMedium}"
                                       Foreground="{DynamicResource BrushError}" />
                        </StackPanel>
                    </Border>

                    <!-- Alerta de Éxito / Estado Demo -->
                    <Border IsVisible="{Binding TieneExito}"
                            Background="{DynamicResource BrushSuccessSubtle}"
                            BorderBrush="{DynamicResource BrushSuccess}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <LucideIcon Kind="Check" Size="16" Foreground="{DynamicResource BrushSuccess}" />
                            <TextBlock Text="{Binding MensajeExito}"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="{StaticResource FontWeightMedium}"
                                       Foreground="{DynamicResource BrushSuccess}" />
                        </StackPanel>
                    </Border>

                    <!-- Botón Principal de Ingreso -->
                    <Button Command="{Binding IngresarCommand}"
                            IsDefault="True"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            MinHeight="44"
                            Background="{DynamicResource BrushPrimary}"
                            Foreground="{DynamicResource BrushTextOnPrimary}"
                            CornerRadius="{StaticResource RadiusMedium}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <LucideIcon Kind="KeyRound" Size="18" />
                            <TextBlock Text="Iniciar Sesión en Terminal"
                                       FontWeight="{StaticResource FontWeightSemiBold}"
                                       FontSize="{StaticResource FontSizeSubtitle}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AlternarModoPinCommand}"
                            HorizontalAlignment="Center"
                            Padding="8,4">
                        <TextBlock Text="Alternar ingreso con Contraseña / Teclado PIN Táctil"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </Button>

                    <Separator Background="{DynamicResource BrushBorderSubtle}" Height="1" Margin="0,4" />

                    <!-- Asistencia Demo y Selección Rápida de 10 Roles -->
                    <StackPanel Spacing="8">
                        <Button Command="{Binding AlternarPanelDemoCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="8,6"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="Sparkles" Size="14" Foreground="{DynamicResource BrushPrimary}" />
                                <TextBlock Text="Cuentas de Prueba y Base Demo (10 Roles)"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="{StaticResource FontWeightMedium}"
                                           Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                        </Button>

                        <Border IsVisible="{Binding MostrarPanelDemo}"
                                Background="{DynamicResource BrushBackground}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <Button Command="{Binding SembrarDatosDemoCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        MinHeight="36"
                                        Background="{DynamicResource BrushPrimarySubtle}"
                                        Foreground="{DynamicResource BrushPrimary}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <LucideIcon Kind="Database" Size="16" />
                                        <TextBlock Text="Sembrar Base Demo (10 Roles + Catálogo + Turno)"
                                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                                   FontSize="{StaticResource FontSizeBody}" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="Selecciona un rol para autocompletar credenciales:"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushTextTertiary}" />

                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding SeleccionarCredencialDemoCommand}" CommandParameter="admin" Margin="2" Padding="6,3" CornerRadius="4">
                                        <TextBlock Text="Admin (1111)" FontSize="{StaticResource FontSizeCaption}" />
                                    </Button>
                                    <Button Command="{Binding SeleccionarCredencialDemoCommand}" CommandParameter="cajero" Margin="2" Padding="6,3" CornerRadius="4">
                                        <TextBlock Text="Cajero (1234)" FontSize="{StaticResource FontSizeCaption}" />
                                    </Button>
                                    <Button Command="{Binding SeleccionarCredencialDemoCommand}" CommandParameter="supervisor" Margin="2" Padding="6,3" CornerRadius="4">
                                        <TextBlock Text="Supervisor (9988)" FontSize="{StaticResource FontSizeCaption}" />
                                    </Button>
                                    <Button Command="{Binding SeleccionarCredencialDemoCommand}" CommandParameter="gerente" Margin="2" Padding="6,3" CornerRadius="4">
                                        <TextBlock Text="Gerente (3344)" FontSize="{StaticResource FontSizeCaption}" />
                                    </Button>
                                    <Button Command="{Binding SeleccionarCredencialDemoCommand}" CommandParameter="bodega" Margin="2" Padding="6,3" CornerRadius="4">
                                        <TextBlock Text="Bodeguero (2233)" FontSize="{StaticResource FontSizeCaption}" />
                                    </Button>
                                    <Button Command="{Binding SeleccionarCredencialDemoCommand}" CommandParameter="compras" Margin="2" Padding="6,3" CornerRadius="4">
                                        <TextBlock Text="Compras (4455)" FontSize="{StaticResource FontSizeCaption}" />
                                    </Button>
                                    <Button Command="{Binding SeleccionarCredencialDemoCommand}" CommandParameter="contador" Margin="2" Padding="6,3" CornerRadius="4">
                                        <TextBlock Text="Contador (5566)" FontSize="{StaticResource FontSizeCaption}" />
                                    </Button>
                                    <Button Command="{Binding SeleccionarCredencialDemoCommand}" CommandParameter="soporte" Margin="2" Padding="6,3" CornerRadius="4">
                                        <TextBlock Text="Soporte (6677)" FontSize="{StaticResource FontSizeCaption}" />
                                    </Button>
                                    <Button Command="{Binding SeleccionarCredencialDemoCommand}" CommandParameter="atencion" Margin="2" Padding="6,3" CornerRadius="4">
                                        <TextBlock Text="Atención (7788)" FontSize="{StaticResource FontSizeCaption}" />
                                    </Button>
                                    <Button Command="{Binding SeleccionarCredencialDemoCommand}" CommandParameter="analista" Margin="2" Padding="6,3" CornerRadius="4">
                                        <TextBlock Text="Analista (8899)" FontSize="{StaticResource FontSizeCaption}" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
