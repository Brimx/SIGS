<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Supermercado.GUI.ViewModels"
             x:Class="Supermercado.GUI.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource BrushBackground}"
             FontFamily="{StaticResource FontFamilyPlex}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding AnchoColumnaSidebar}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- BARRA LATERAL MODULAR (SIDEBAR) - OCULTA EN MODO CAJERO PURO PANTALLA COMPLETA -->
        <Border Grid.Column="0"
                IsVisible="{Binding MostrarBarraLateral}"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,0,1,0"
                Padding="14,18">
            <Grid RowDefinitions="Auto,20,*,Auto">

                <!-- Identidad de Marca SIGS -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="6,0">
                    <Border Background="{DynamicResource BrushPrimary}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Width="36" Height="36">
                        <LucideIcon Kind="Store"
                                    Size="20"
                                    Foreground="{DynamicResource BrushTextOnPrimary}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SIGS RETAIL"
                                   FontFamily="{StaticResource FontFamilyStackSans}"
                                   FontSize="{StaticResource FontSizeSubtitle}"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        <TextBlock Text="DIAN POS · v1.0"
                                   FontFamily="{StaticResource FontFamilyPlexCondensed}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Menú de Módulos Filtrado Dinámicamente por Permisos RBAC -->
                <ScrollViewer Grid.Row="2">
                    <StackPanel Spacing="5">
                        <TextBlock Text="OPERACIÓN DE CAJA"
                                   IsVisible="{Binding PuedeVerPos}"
                                   Margin="8,0,0,4"
                                   FontFamily="{StaticResource FontFamilyStackSans}"
                                   FontSize="10.5"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   Foreground="{DynamicResource BrushTextMuted}" />

                        <Button Command="{Binding NavegarCommand}"
                                CommandParameter="POS"
                                IsVisible="{Binding PuedeVerPos}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                MinHeight="40"
                                Padding="12,0" Classes="Navegacion" Theme="{DynamicResource BorderlessButton}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <LucideIcon Kind="ShoppingCart" Size="18" Foreground="{DynamicResource BrushPrimaryText}" />
                                <TextBlock Text="Punto de Venta (POS)" FontWeight="{StaticResource FontWeightSemiBold}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavegarCommand}"
                                CommandParameter="Turno"
                                IsVisible="{Binding PuedeVerTurno}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                MinHeight="40"
                                Padding="12,0" Classes="Navegacion" Theme="{DynamicResource BorderlessButton}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <LucideIcon Kind="Wallet" Size="18" Foreground="{DynamicResource BrushPrimaryText}" />
                                <TextBlock Text="Turno y Arqueo Z" FontWeight="{StaticResource FontWeightSemiBold}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavegarCommand}"
                                CommandParameter="Clientes"
                                IsVisible="{Binding PuedeVerClientes}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                MinHeight="40"
                                Padding="12,0" Classes="Navegacion" Theme="{DynamicResource BorderlessButton}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <LucideIcon Kind="UserPlus" Size="18" Foreground="{DynamicResource BrushPrimaryText}" />
                                <TextBlock Text="Clientes / Habeas Data" FontWeight="{StaticResource FontWeightSemiBold}" />
                            </StackPanel>
                        </Button>

                        <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,6" Height="1" />

                        <TextBlock Text="GESTIÓN Y BACK-OFFICE"
                                   Margin="8,0,0,4"
                                   FontFamily="{StaticResource FontFamilyStackSans}"
                                   FontSize="10.5"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   Foreground="{DynamicResource BrushTextMuted}" />

                        <Button Command="{Binding NavegarCommand}"
                                CommandParameter="Inventario"
                                IsVisible="{Binding PuedeVerInventario}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                MinHeight="40"
                                Padding="12,0" Classes="Navegacion" Theme="{DynamicResource BorderlessButton}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <LucideIcon Kind="Boxes" Size="18" Foreground="{DynamicResource BrushPrimaryText}" />
                                <TextBlock Text="Inventario y Mermas" FontWeight="{StaticResource FontWeightSemiBold}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavegarCommand}"
                                CommandParameter="Compras"
                                IsVisible="{Binding PuedeVerCompras}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                MinHeight="40"
                                Padding="12,0" Classes="Navegacion" Theme="{DynamicResource BorderlessButton}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <LucideIcon Kind="Truck" Size="18" Foreground="{DynamicResource BrushPrimaryText}" />
                                <TextBlock Text="Compras y Proveedores" FontWeight="{StaticResource FontWeightSemiBold}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavegarCommand}"
                                CommandParameter="Personal"
                                IsVisible="{Binding PuedeVerPersonal}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                MinHeight="40"
                                Padding="12,0" Classes="Navegacion" Theme="{DynamicResource BorderlessButton}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <LucideIcon Kind="Users" Size="18" Foreground="{DynamicResource BrushPrimaryText}" />
                                <TextBlock Text="Personal y Roles RBAC" FontWeight="{StaticResource FontWeightSemiBold}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavegarCommand}"
                                CommandParameter="Contabilidad"
                                IsVisible="{Binding PuedeVerContabilidad}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                MinHeight="40"
                                Padding="12,0" Classes="Navegacion" Theme="{DynamicResource BorderlessButton}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <LucideIcon Kind="FileSpreadsheet" Size="18" Foreground="{DynamicResource BrushPrimaryText}" />
                                <TextBlock Text="Contabilidad Fiscal DIAN" FontWeight="{StaticResource FontWeightSemiBold}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavegarCommand}"
                                CommandParameter="Dashboard"
                                IsVisible="{Binding PuedeVerDashboard}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                MinHeight="40"
                                Padding="12,0" Classes="Navegacion" Theme="{DynamicResource BorderlessButton}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <LucideIcon Kind="LayoutDashboard" Size="18" Foreground="{DynamicResource BrushPrimaryText}" />
                                <TextBlock Text="Dashboard Ejecutivo" FontWeight="{StaticResource FontWeightSemiBold}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pie de Barra Lateral: Usuario, Tema y Cierre de Sesión -->
                <StackPanel Grid.Row="3" Spacing="10">
                    <Separator Background="{DynamicResource BrushBorderSubtle}" Height="1" />

                    <Border Background="{DynamicResource BrushSurfaceSubtle}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding NombreUsuarioActivo}"
                                           FontWeight="{StaticResource FontWeightBold}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="{Binding RolUsuarioActivo}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushPrimaryText}"
                                           FontWeight="{StaticResource FontWeightSemiBold}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding AlternarTemaCommand}"
                                    ToolTip.Tip="Cambiar tema: Claro cálido → Oscuro Slate → Alto contraste"
                                    Padding="8,6" Classes="Icono" Theme="{DynamicResource BorderlessButton}">
                                <LucideIcon Kind="Sun" Size="16" />
                            </Button>
                        </Grid>
                    </Border>

                    <Button Command="{Binding AbrirConfiguracionCommand}"
                            Classes="Navegacion"
                            Theme="{DynamicResource BorderlessButton}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <LucideIcon Kind="Settings" Size="16" Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock Text="Configuración" FontWeight="{StaticResource FontWeightSemiBold}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CerrarSesionCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            MinHeight="38" Classes="DestructivoSuave" Theme="{DynamicResource BorderlessButton}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <LucideIcon Kind="LogOut" Size="16" Foreground="{DynamicResource BrushErrorText}" />
                            <TextBlock Text="Cerrar Sesión"
                                       FontWeight="{StaticResource FontWeightSemiBold}"
                                       Foreground="{DynamicResource BrushErrorText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ÁREA PRINCIPAL (HEADER + CONTENIDO TRANSACCIONAL) -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Header Superior con Controles Rápidos para Modo Cajero Pantalla Completa -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid ColumnDefinitions="*,Auto,10,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding TituloModulo}"
                                   FontFamily="{StaticResource FontFamilyStackSans}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        <TextBlock Text="{Binding SubtituloModulo}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>

                    <!-- Barra compacta visible cuando la barra lateral está oculta (Modo Cajero Puro) -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                IsVisible="{Binding EsModoCajeroPantallaCompleta}"
                                VerticalAlignment="Center">
                        <Button Command="{Binding NavegarCommand}" CommandParameter="POS" Padding="10,6" Theme="{DynamicResource BorderlessButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="ShoppingCart" Size="15" Foreground="{DynamicResource BrushPrimaryText}" />
                                <TextBlock Text="Terminal POS" FontWeight="{StaticResource FontWeightSemiBold}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavegarCommand}" CommandParameter="Turno" Padding="10,6" Theme="{DynamicResource BorderlessButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="Wallet" Size="15" Foreground="{DynamicResource BrushPrimaryText}" />
                                <TextBlock Text="Turno / Arqueo Z" FontWeight="{StaticResource FontWeightSemiBold}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AlternarTemaCommand}" Padding="8,6" ToolTip.Tip="Alternar Tema" Classes="Icono" Theme="{DynamicResource BorderlessButton}">
                            <LucideIcon Kind="Sun" Size="15" />
                        </Button>
                        <Button Command="{Binding AbrirConfiguracionCommand}" Padding="8,6" ToolTip.Tip="Configuración" Classes="Icono" Theme="{DynamicResource BorderlessButton}">
                            <LucideIcon Kind="Settings" Size="15" />
                        </Button>
                        <Button Command="{Binding CerrarSesionCommand}" Padding="10,6" Classes="DestructivoSuave" Theme="{DynamicResource BorderlessButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="LogOut" Size="15" Foreground="{DynamicResource BrushErrorText}" />
                                <TextBlock Text="{Binding NombreUsuarioActivo, StringFormat='Salir ({0})'}" Foreground="{DynamicResource BrushErrorText}" FontWeight="{StaticResource FontWeightSemiBold}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="3"
                            Background="{DynamicResource BrushSuccessSubtle}"
                            BorderBrush="{DynamicResource BrushSuccessText}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPill}"
                            VerticalAlignment="Center"
                            Padding="12,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="ShieldCheck" Size="14" Foreground="{DynamicResource BrushSuccessText}" />
                            <TextBlock Text="SQLite ACID + DIAN Sandbox Activo"
                                       FontFamily="{StaticResource FontFamilyPlexCondensed}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="{StaticResource FontWeightBold}"
                                       Foreground="{DynamicResource BrushSuccessText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Contenedor de Vistas con Transición Asimétrica Suave (150ms CrossFade) -->
            <TransitioningContentControl Grid.Row="1" Content="{Binding PaginaActual}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.15" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Grid>
    </Grid>
</UserControl>
