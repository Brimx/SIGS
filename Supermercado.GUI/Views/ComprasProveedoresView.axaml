<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Supermercado.GUI.ViewModels"
             x:Class="Supermercado.GUI.Views.ComprasProveedoresView"
             x:DataType="vm:ComprasProveedoresViewModel"
             FontFamily="{StaticResource FontFamilyPlex}">

    <Grid RowDefinitions="Auto,16,*" Margin="16">

        <!-- Cabecera de Acciones y Categorías -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="16,12">
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Directorio de Proveedores y Sugeridos FEFO"
                               FontFamily="{StaticResource FontFamilyStackSans}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="{StaticResource FontWeightBold}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="Directorio de Proveedores y Sugeridos de Reabastecimiento FEFO" />
                    <TextBlock Text="Gestión de proveedores NIT y solicitudes automáticas de bodega a góndola."
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <WrapPanel>
                    <TextBox Width="220"
                             Margin="0,0,8,8"
                             Text="{Binding NuevaCategoriaInput}"
                             PlaceholderText="Nueva categoría (ej. Lácteos)..."
                             MinHeight="{StaticResource SizeTouchTarget}" />
                    <Button Margin="0,0,8,8"
                            Command="{Binding CrearCategoriaCommand}"
                            MinHeight="{StaticResource SizeTouchTarget}">
                        <TextBlock Text="+ Categoría" FontWeight="{StaticResource FontWeightSemiBold}" />
                    </Button>
                    <Button Margin="0,0,8,8"
                            Command="{Binding CargarDatosCommand}"
                            Classes="Primary" Theme="{DynamicResource SolidButton}"
                            MinHeight="{StaticResource SizeTouchTarget}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="RefreshCw" Size="16" />
                            <TextBlock Text="Actualizar" FontWeight="{StaticResource FontWeightSemiBold}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Cuerpo Principal: Izquierda Proveedores / Derecha Sugeridos de Compra y Reabastecimiento -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="520">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

            <!-- Columna Izquierda: CRUD de Proveedores -->
            <Grid Grid.Column="0" RowDefinitions="Auto,12,*">
                <Border Grid.Row="0"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Ficha de Proveedor Comercial"
                                   FontFamily="{StaticResource FontFamilyStackSans}"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="Ficha de Proveedor Comercial" />

                        <WrapPanel>
                            <TextBox Width="170"
                                     Margin="0,0,8,8"
                                     Text="{Binding NombreProveedorInput}"
                                     PlaceholderText="Razón Social / Proveedor"
                                     ToolTip.Tip="Razón Social / Proveedor" />
                            <TextBox Width="150"
                                     Margin="0,0,8,8"
                                     Text="{Binding NitProveedorInput}"
                                     PlaceholderText="NIT (ej. 900123456-1)"
                                     FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                            <TextBox Width="130"
                                     Margin="0,0,8,8"
                                     Text="{Binding TelefonoProveedorInput}"
                                     PlaceholderText="Teléfono"
                                     FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                            <TextBox Width="170"
                                     Margin="0,0,8,8"
                                     Text="{Binding CorreoProveedorInput}"
                                     PlaceholderText="Correo de pedidos" />
                        </WrapPanel>

                        <WrapPanel HorizontalAlignment="Right">
                            <Button Margin="0,0,8,8"
                                    MinHeight="{StaticResource SizeTouchTarget}"
                                    Command="{Binding LimpiarFormularioProveedorCommand}">
                                <TextBlock Text="Nuevo / Limpiar" TextWrapping="Wrap" />
                            </Button>
                            <Button Margin="0,0,8,8"
                                    Command="{Binding GuardarProveedorCommand}"
                                    Classes="Primary" Theme="{DynamicResource SolidButton}"
                                    MinHeight="{StaticResource SizeTouchTarget}"
                                    Padding="16,8">
                                <Grid ColumnDefinitions="Auto,8,*">
                                    <LucideIcon Grid.Column="0" Kind="Save" Size="16" />
                                    <TextBlock Grid.Column="2"
                                               Text="Guardar Proveedor"
                                               FontWeight="{StaticResource FontWeightBold}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Proveedores}"
                              SelectedItem="{Binding ProveedorSeleccionado}"
                              MinHeight="180"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" MinWidth="60" FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                            <DataGridTextColumn Header="RAZÓN SOCIAL" Binding="{Binding Nombre}" Width="*" MinWidth="160" />
                            <DataGridTextColumn Header="NIT" Binding="{Binding Nit}" Width="140" MinWidth="120" FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                            <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="125" MinWidth="110" FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                            <DataGridTextColumn Header="CORREO" Binding="{Binding Correo}" Width="190" MinWidth="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Columna Derecha: Sugeridos Automáticos y Reabastecimiento -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}"
                    Padding="18">
                <Grid RowDefinitions="Auto,12,Auto,12,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <LucideIcon Kind="Truck" Size="20" Foreground="{DynamicResource BrushPrimaryText}" />
                        <TextBlock Text="Sugeridos de Compra y Traslado"
                                   FontFamily="{StaticResource FontFamilyStackSans}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   MaxWidth="220"
                                   TextWrapping="Wrap"
                                   ToolTip.Tip="Sugeridos de Compra y Traslado" />
                    </StackPanel>

                    <Button Grid.Row="2"
                            Command="{Binding GenerarSugeridosAutomaticosCommand}"
                            Background="{DynamicResource BrushPrimarySubtle}"
                            BorderBrush="{DynamicResource BrushPrimaryText}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             MinHeight="{StaticResource SizeTouchTarget}">
                        <Grid ColumnDefinitions="Auto,8,*">
                            <LucideIcon Grid.Column="0" Kind="Sparkles" Size="16" Foreground="{DynamicResource BrushPrimaryText}" />
                            <TextBlock Grid.Column="2"
                                       Text="Calcular Sugeridos según Stock Mínimo"
                                       FontWeight="{StaticResource FontWeightBold}"
                                       Foreground="{DynamicResource BrushPrimaryText}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Button>

                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding SolicitudesPendientes}"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="320"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SolicitudReabastecimientoItemViewModel">
                                <Border Background="{DynamicResource BrushSurfaceSubtle}"
                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        Margin="0,4"
                                        Padding="12,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding NombreProducto}"
                                                       FontWeight="{StaticResource FontWeightBold}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding NombreProducto}" />
                                            <TextBlock Text="{Binding CodigoBarras, StringFormat='EAN: {0}'}"
                                                       FontFamily="{StaticResource FontFamilyPlexCondensed}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{DynamicResource BrushTextSecondary}" />
                                            <TextBlock Text="{Binding CantidadSolicitada, StringFormat='Cantidad sugerida a surtir: {0} uds/g'}"
                                                       FontFamily="{StaticResource FontFamilyPlexCondensed}"
                                                       FontWeight="{StaticResource FontWeightSemiBold}"
                                                       Foreground="{DynamicResource BrushWarningText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Command="{Binding $parent[UserControl].((vm:ComprasProveedoresViewModel)DataContext).AtenderSolicitudReabastecimientoCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center"
                                                Classes="Success" Theme="{DynamicResource SolidButton}"
                                                MinHeight="{StaticResource SizeTouchTarget}"
                                                Padding="12,6">
                                            <TextBlock Text="Surtir Estante" FontWeight="{StaticResource FontWeightBold}" TextWrapping="Wrap" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
