<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Supermercado.GUI.ViewModels"
             x:Class="Supermercado.GUI.Views.ContabilidadDianView"
             x:DataType="vm:ContabilidadDianViewModel"
             FontFamily="{StaticResource FontFamilyPlex}">

    <Grid RowDefinitions="Auto,16,Auto,16,*,12,Auto" Margin="16">

        <!-- Cabecera de Filtros y Exportación Fiscal CSV / PDF -->
        <Border Grid.Row="0"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="16,12">
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Finanzas, IVA y Arqueos Z"
                               FontFamily="{StaticResource FontFamilyStackSans}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="{StaticResource FontWeightBold}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="Finanzas, Consolidado de IVA y Arqueos Z" />
                    <TextBlock Text="Liquidación por tarifas (0%, 5%, 19%), gastos y exportación contable."
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <WrapPanel>
                    <TextBlock Text="Días:"
                               Margin="0,0,8,8"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                    <NumericUpDown Width="110"
                                   Margin="0,0,8,8"
                                   Value="{Binding DiasRangoConsulta}"
                                   Minimum="1"
                                   Maximum="365"
                                   FormatString="0"
                                   FontFamily="{StaticResource FontFamilyPlexCondensed}"
                                   MinHeight="{StaticResource SizeTouchTarget}" />
                    <Button Margin="0,0,8,8"
                            Command="{Binding ActualizarConsolidadoFiscalCommand}"
                            MinHeight="{StaticResource SizeTouchTarget}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="RefreshCw" Size="16" />
                            <TextBlock Text="Calcular" FontWeight="{StaticResource FontWeightSemiBold}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,8"
                            Command="{Binding ExportarCsvContableCommand}"
                            Classes="Success" Theme="{DynamicResource SolidButton}"
                            MinHeight="{StaticResource SizeTouchTarget}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="FileSpreadsheet" Size="16" />
                            <TextBlock Text="Exportar CSV / Excel" FontWeight="{StaticResource FontWeightBold}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,8"
                            Command="{Binding ExportarPdfVentasDianCommand}"
                            Classes="Primary" Theme="{DynamicResource SolidButton}"
                            MinHeight="{StaticResource SizeTouchTarget}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="FileText" Size="16" />
                            <TextBlock Text="Exportar PDF" FontWeight="{StaticResource FontWeightBold}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Tarjetas KPI de Resumen Financiero del Periodo -->
        <Grid Grid.Row="2" RowDefinitions="Auto,12,Auto" ColumnDefinitions="*,12,*">
            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="INGRESOS BRUTOS VENTAS" FontFamily="{StaticResource FontFamilyStackSans}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource FontWeightBold}" Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBlock Text="{Binding IngresosTotalesFormateado}" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeHeadline}" FontWeight="{StaticResource FontWeightBold}" Foreground="{DynamicResource BrushPrimaryText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding IngresosTotalesFormateado}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="TOTAL IVA GENERADO" FontFamily="{StaticResource FontFamilyStackSans}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource FontWeightBold}" Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBlock Text="{Binding IvaTotalGeneradoFormateado}" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeHeadline}" FontWeight="{StaticResource FontWeightBold}" Foreground="{DynamicResource BrushWarningText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding IvaTotalGeneradoFormateado}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="GASTOS OPERATIVOS" FontFamily="{StaticResource FontFamilyStackSans}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource FontWeightBold}" Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBlock Text="{Binding EgresosTotalesFormateado}" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeHeadline}" FontWeight="{StaticResource FontWeightBold}" Foreground="{DynamicResource BrushErrorText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EgresosTotalesFormateado}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="MARGEN NETO OPERATIVO" FontFamily="{StaticResource FontFamilyStackSans}" FontSize="{StaticResource FontSizeCaption}" FontWeight="{StaticResource FontWeightBold}" Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBlock Text="{Binding MargenOperativoFormateado}" FontFamily="{StaticResource FontFamilyPlexCondensed}" FontSize="{StaticResource FontSizeHeadline}" FontWeight="{StaticResource FontWeightBold}" Foreground="{DynamicResource BrushSuccessText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MargenOperativoFormateado}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Cuerpo: Izquierda Discriminación por Tarifas de IVA y Gastos / Derecha Historial de Arqueos Z -->
        <Grid Grid.Row="4" ColumnDefinitions="*,16,*">

            <!-- Izquierda: Desglose Tributario IVA (0%, 5%, 19%) y Registro de Gastos -->
            <Grid Grid.Column="0" RowDefinitions="*,12,Auto">
                <Border Grid.Row="0"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceSubtle}" Padding="14,10" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <TextBlock Text="DISCRIMINACIÓN IVA (0% · 5% · 19%)"
                                       FontFamily="{StaticResource FontFamilyStackSans}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="{StaticResource FontWeightBold}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="Discriminación fiscal por tarifa de IVA (0% · 5% · 19%)" />
                        </Border>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DesgloseIvaTarifas}"
                                  IsReadOnly="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TARIFA" Binding="{Binding CodigoTarifa}" Width="75" MinWidth="65" FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                                <DataGridTextColumn Header="CONCEPTO" Binding="{Binding DescripcionTarifa}" Width="*" MinWidth="130" />
                                <DataGridTextColumn Header="BASE" Binding="{Binding BaseFormateada}" Width="125" MinWidth="100" FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                                <DataGridTextColumn Header="IVA" Binding="{Binding ImpuestoFormateado}" Width="120" MinWidth="95" FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalFormateado}" Width="125" MinWidth="100" FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Formulario de Registro de Gasto Operativo -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="14,10">
                    <WrapPanel>
                        <TextBox Width="240"
                                 Margin="0,0,8,8"
                                 Text="{Binding DescripcionGastoInput}"
                                 PlaceholderText="Registrar egreso / gasto operativo..."
                                 ToolTip.Tip="Registrar egreso / gasto operativo (ej. Servicios públicos, flete)" />
                        <NumericUpDown Width="150"
                                       Margin="0,0,8,8"
                                       Value="{Binding MontoGastoInput}"
                                       Minimum="1000"
                                       Increment="10000"
                                       FormatString="N0"
                                       FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        <Button Margin="0,0,8,8"
                                Command="{Binding RegistrarGastoOperativoCommand}"
                                Classes="Primary" Theme="{DynamicResource SolidButton}"
                                MinHeight="{StaticResource SizeTouchTarget}">
                            <TextBlock Text="Registrar Egreso" FontWeight="{StaticResource FontWeightSemiBold}" TextWrapping="Wrap" />
                        </Button>
                    </WrapPanel>
                </Border>
            </Grid>

            <!-- Derecha: Auditoría de Arqueos Diarios / Cierres Z -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceSubtle}" Padding="14,10" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                        <TextBlock Text="CONCILIACIÓN Y ARQUEOS Z"
                                   FontFamily="{StaticResource FontFamilyStackSans}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="Conciliación de turnos y arqueos ciegos (cierre Z)" />
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding HistorialArqueos}"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TURNO" Binding="{Binding Id}" Width="70" MinWidth="60" FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                            <DataGridTextColumn Header="APERTURA" Binding="{Binding AperturaTexto}" Width="130" MinWidth="110" FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                            <DataGridTextColumn Header="ESPERADO" Binding="{Binding EsperadoFormateado}" Width="115" MinWidth="100" FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                            <DataGridTextColumn Header="CONTADO" Binding="{Binding ContadoFormateado}" Width="115" MinWidth="100" FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                            <DataGridTextColumn Header="DIFERENCIA" Binding="{Binding DiferenciaFormateada}" Width="*" MinWidth="100" FontFamily="{StaticResource FontFamilyPlexCondensed}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra de Estado -->
        <Border Grid.Row="6"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusSmall}"
                Padding="12,8">
            <TextBlock Text="{Binding MensajeEstado}" FontWeight="{StaticResource FontWeightMedium}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MensajeEstado}" />
        </Border>
    </Grid>
</UserControl>
