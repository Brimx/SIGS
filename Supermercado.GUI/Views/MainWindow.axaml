<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Supermercado.GUI.ViewModels"
        xmlns:views="using:Supermercado.GUI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="820"
        x:Class="Supermercado.GUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1360" Height="820"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/avalonia-logo.ico"
        Background="{DynamicResource BrushBackground}"
        FontFamily="{StaticResource FontFamilyPlex}"
        Title="SIGS · Sistema Integral de Gestión de Supermercado (DIAN POS)">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <TransitioningContentControl Content="{Binding VistaActual}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.15" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <!-- Overlay compartido por login y shell -->
        <Border Classes="Scrim" IsVisible="{Binding MostrarConfiguracion}">
            <views:ConfiguracionView DataContext="{Binding ConfiguracionVm}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
        </Border>
    </Panel>
</Window>
