<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Supermercado.GUI.ViewModels"
             x:Class="Supermercado.GUI.Views.ConfiguracionView"
             x:DataType="vm:ConfiguracionViewModel"
             Width="760"
             MaxHeight="680">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorderSubtle}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}"
            Padding="24">
        <Grid RowDefinitions="Auto,*,Auto">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Classes="Titulo" Text="Configuración" />
                    <TextBlock Classes="Ayuda"
                               Text="Preferencias de esta máquina · visibles para todos los roles" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="Icono"
                        Theme="{DynamicResource BorderlessButton}"
                        Command="{Binding CerrarCommand}"
                        ToolTip.Tip="Cerrar">
                    <LucideIcon Kind="X" Size="18" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,16">
                <StackPanel Spacing="16">

                    <!-- APARIENCIA -->
                    <Border Classes="Tarjeta">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="Etiqueta" Text="Apariencia" />
                            <Grid ColumnDefinitions="*,10,*,10,*">
                                <Button Grid.Column="0"
                                        Classes="Tarjeta"
                                        Classes.Seleccionada="{Binding EsClaro}"
                                        Theme="{DynamicResource OutlineButton}"
                                        Command="{Binding SeleccionarTemaCommand}"
                                        CommandParameter="Claro">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Claro cálido"
                                                   FontWeight="{StaticResource FontWeightSemiBold}" />
                                        <TextBlock Classes="Ayuda"
                                                   Text="Marfil, pensado para turnos largos de caja."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Classes="Tarjeta"
                                        Classes.Seleccionada="{Binding EsOscuro}"
                                        Theme="{DynamicResource OutlineButton}"
                                        Command="{Binding SeleccionarTemaCommand}"
                                        CommandParameter="Oscuro">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Oscuro Slate"
                                                   FontWeight="{StaticResource FontWeightSemiBold}" />
                                        <TextBlock Classes="Ayuda"
                                                   Text="Bajo consumo visual en ambientes con poca luz."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4"
                                        Classes="Tarjeta"
                                        Classes.Seleccionada="{Binding EsAltoContraste}"
                                        Theme="{DynamicResource OutlineButton}"
                                        Command="{Binding SeleccionarTemaCommand}"
                                        CommandParameter="AltoContraste">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Alto contraste"
                                                   FontWeight="{StaticResource FontWeightSemiBold}" />
                                        <TextBlock Classes="Ayuda"
                                                   Text="Negro, texto blanco y acentos AAA."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- LEGAL -->
                    <Border Classes="Tarjeta">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="Etiqueta" Text="Legal" />
                            <TextBlock Text="Política de privacidad"
                                       FontWeight="{StaticResource FontWeightSemiBold}" />
                            <ScrollViewer MaxHeight="180">
                                <SelectableTextBlock Text="{Binding TextoPrivacidad}"
                                                     TextWrapping="Wrap"
                                                     FontSize="{StaticResource FontSizeCaption}"
                                                     Foreground="{DynamicResource BrushTextSecondary}" />
                            </ScrollViewer>
                            <TextBlock Text="Términos y condiciones"
                                       FontWeight="{StaticResource FontWeightSemiBold}" />
                            <ScrollViewer MaxHeight="180">
                                <SelectableTextBlock Text="{Binding TextoTerminos}"
                                                     TextWrapping="Wrap"
                                                     FontSize="{StaticResource FontSizeCaption}"
                                                     Foreground="{DynamicResource BrushTextSecondary}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- ACERCA DE -->
                    <Border Classes="Tarjeta">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="Etiqueta" Text="Acerca de" />
                            <TextBlock Text="SIGS · Sistema Integral de Gestión de Supermercado"
                                       FontWeight="{StaticResource FontWeightSemiBold}" />
                            <TextBlock Classes="Ayuda"
                                       Text="{Binding Version, StringFormat='Versión {0}'}" />
                            <TextBlock Classes="Ayuda"
                                       Text="Avalonia 12 · Semi.Avalonia · Lucide Icons · IBM Plex Sans" />
                            <TextBlock Classes="Ayuda"
                                       Text="Sin telemetría. Los datos permanecen en este equipo; solo se generan logs locales."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2"
                    Content="Cerrar"
                    HorizontalAlignment="Right"
                    Theme="{DynamicResource OutlineButton}"
                    Command="{Binding CerrarCommand}" />
        </Grid>
    </Border>
</UserControl>
