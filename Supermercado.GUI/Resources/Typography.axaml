<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
    <!-- Familias Tipográficas -->
    <FontFamily x:Key="FontFamilyStackSans">avares://Supermercado.GUI/Assets/Fonts#Stack Sans Headline</FontFamily>
    <FontFamily x:Key="FontFamilyPlex">avares://Supermercado.GUI/Assets/Fonts#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="FontFamilyPlexCondensed">avares://Supermercado.GUI/Assets/Fonts#IBM Plex Sans Condensed</FontFamily>

    <!-- Escala Formal de Tamaños (Double) -->
    <x:Double x:Key="FontSizeDisplay">32</x:Double>
    <x:Double x:Key="FontSizeHeadline">24</x:Double>
    <x:Double x:Key="FontSizeTitle">18</x:Double>
    <x:Double x:Key="FontSizeSubtitle">15</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeCaption">11</x:Double>

    <!-- 4 Pesos Tipográficos Estrictos (WCAG 2.2) -->
    <FontWeight x:Key="FontWeightRegular">Regular</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>
</ResourceDictionary>
