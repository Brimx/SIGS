            <SolidColorBrush x:Key="CheckBoxPointeroverBorderBrush" Color="{StaticResource ColorBrand700}" />
            <SolidColorBrush x:Key="CheckBoxPressedBackground" Color="{StaticResource ColorWarm200}" />
            <SolidColorBrush x:Key="CheckBoxPressedBorderBrush" Color="{StaticResource ColorBrand800}" />
            <SolidColorBrush x:Key="CheckBoxCheckedDefaultBackground" Color="{StaticResource ColorBrand700}" />
            <SolidColorBrush x:Key="CheckBoxCheckedDefaultBorderBrush" Color="{StaticResource ColorBrand700}" />
            <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBackground" Color="{StaticResource ColorBrand800}" />
            <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBorderBrush" Color="{StaticResource ColorBrand800}" />
            <SolidColorBrush x:Key="CheckBoxCheckedPressedBackground" Color="{StaticResource ColorBrand900}" />
            <SolidColorBrush x:Key="CheckBoxCheckedPressedBorderBrush" Color="{StaticResource ColorBrand900}" />
            <SolidColorBrush x:Key="CheckBoxDefaultDisabledBackground" Color="{StaticResource ColorWarm200}" />
