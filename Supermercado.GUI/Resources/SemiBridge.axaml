            <SolidColorBrush x:Key="HyperlinkButtonDisabledForeground" Color="{StaticResource ColorWarm600}" />
            <SolidColorBrush x:Key="HyperlinkButtonVisitedForeground" Color="{StaticResource ColorBrand700}" />
        </ResourceDictionary>

