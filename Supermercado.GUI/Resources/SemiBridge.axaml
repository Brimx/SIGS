            <SolidColorBrush x:Key="ComboBoxIconDefaultForeground" Color="{StaticResource ColorWarm700}" />
            <SolidColorBrush x:Key="ComboBoxIconPointeroverForeground" Color="{StaticResource ColorWarm900}" />
            <SolidColorBrush x:Key="ComboBoxIconFocusForeground" Color="{StaticResource ColorBrand700}" />
            <SolidColorBrush x:Key="ComboBoxIconPressedForeground" Color="{StaticResource ColorWarm900}" />
            <SolidColorBrush x:Key="ComboBoxIconDisabledForeground" Color="{StaticResource ColorWarm600}" />
