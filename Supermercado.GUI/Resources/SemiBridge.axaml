            <SolidColorBrush x:Key="DataValidationErrorsPointeroverBackground" Color="{StaticResource ColorError100}" />
            <SolidColorBrush x:Key="DataValidationErrorsPointeroverBorderBrush" Color="{StaticResource ColorError700}" />
            <SolidColorBrush x:Key="DataValidationErrorsPointerOverBackground" Color="{StaticResource ColorError100}" />
            <SolidColorBrush x:Key="DataValidationErrorsPointerOverBorderBrush" Color="{StaticResource ColorError700}" />
            <SolidColorBrush x:Key="DataValidationErrorsPressedBackground" Color="{StaticResource ColorError100}" />
            <SolidColorBrush x:Key="DataValidationErrorsPressedBorderBrush" Color="{StaticResource ColorError800}" />
