<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tema="using:Supermercado.GUI.Servicios.Tema">
    <!--
        Puente entre Semi.Avalonia y SIGS.

        Los ControlTheme de Semi consumen sus colores con {DynamicResource Clave}. Esas claves se resuelven
        en tiempo de ejecución desde el control, y Application.Resources se consulta antes que
        Application.Styles (donde vive SemiTheme). Definir aquí la clave remapea el control completo.

        No se sobrescriben las claves `SemiColor*`: Semi las resuelve con {StaticResource} dentro de sus
        propios diccionarios de tema, así que un override en Application.Resources no surte efecto. Por eso
        se remapean las claves finales (`ButtonDefault*`, `ButtonSolid*`, `TextBox*`, `ComboBox*`, ...).

        Solo se cubren los controles que usa el repo: Button, TextBox, CheckBox, ComboBox, DataGrid,
        ScrollBar, ToolTip, Flyout, DataValidationErrors e HyperlinkButton. Las clases Secondary/Tertiary y
        Colorful de Semi no se usan.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Botón base (fondo transparente, texto por rol) -->
            <SolidColorBrush x:Key="ButtonDefaultBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonDefaultPointeroverBackground" Color="{StaticResource ColorWarm200}" />
            <SolidColorBrush x:Key="ButtonDefaultPressedBackground" Color="{StaticResource ColorWarm300}" />
            <SolidColorBrush x:Key="ButtonDefaultBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonDefaultPointeroverBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonDefaultPressedBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground" Color="{StaticResource ColorWarm900}" />
            <SolidColorBrush x:Key="ButtonDefaultSecondaryForeground" Color="{StaticResource ColorWarm700}" />
            <SolidColorBrush x:Key="ButtonDefaultTertiaryForeground" Color="{StaticResource ColorWarm700}" />
            <SolidColorBrush x:Key="ButtonDefaultSuccessForeground" Color="{StaticResource ColorSuccess700}" />
            <SolidColorBrush x:Key="ButtonDefaultWarningForeground" Color="{StaticResource ColorWarning700}" />
            <SolidColorBrush x:Key="ButtonDefaultDangerForeground" Color="{StaticResource ColorError700}" />
            <SolidColorBrush x:Key="ButtonDefaultDisabledForeground" Color="{StaticResource ColorWarm600}" />
            <SolidColorBrush x:Key="ButtonDefaultDisabledBorderBrush" Color="Transparent" />

            <!-- Botón sólido -->
            <SolidColorBrush x:Key="ButtonSolidForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="{StaticResource ColorBrand700}" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBackground" Color="{StaticResource ColorBrand800}" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBackground" Color="{StaticResource ColorBrand900}" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPressedForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush" Color="{StaticResource ColorBrand700}" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush" Color="{StaticResource ColorBrand800}" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush" Color="{StaticResource ColorBrand900}" />
            <SolidColorBrush x:Key="ButtonSolidSuccessBackground" Color="{StaticResource ColorSuccess700}" />
            <SolidColorBrush x:Key="ButtonSolidSuccessPointeroverBackground" Color="{StaticResource ColorSuccess800}" />
            <SolidColorBrush x:Key="ButtonSolidSuccessPressedBackground" Color="{StaticResource ColorSuccess950}" />
            <SolidColorBrush x:Key="ButtonSolidSuccessBorderBrush" Color="{StaticResource ColorSuccess700}" />
            <SolidColorBrush x:Key="ButtonSolidSuccessPointeroverBorderBrush" Color="{StaticResource ColorSuccess800}" />
            <SolidColorBrush x:Key="ButtonSolidSuccessPressedBorderBrush" Color="{StaticResource ColorSuccess950}" />
            <SolidColorBrush x:Key="ButtonSolidWarningBackground" Color="{StaticResource ColorWarning700}" />
            <SolidColorBrush x:Key="ButtonSolidWarningPointeroverBackground" Color="{StaticResource ColorWarning800}" />
            <SolidColorBrush x:Key="ButtonSolidWarningPressedBackground" Color="{StaticResource ColorWarning950}" />
            <SolidColorBrush x:Key="ButtonSolidWarningBorderBrush" Color="{StaticResource ColorWarning700}" />
            <SolidColorBrush x:Key="ButtonSolidWarningPointeroverBorderBrush" Color="{StaticResource ColorWarning800}" />
            <SolidColorBrush x:Key="ButtonSolidWarningPressedBorderBrush" Color="{StaticResource ColorWarning950}" />
            <SolidColorBrush x:Key="ButtonSolidDangerBackground" Color="{StaticResource ColorError700}" />
            <SolidColorBrush x:Key="ButtonSolidDangerPointeroverBackground" Color="{StaticResource ColorError800}" />
            <SolidColorBrush x:Key="ButtonSolidDangerPressedBackground" Color="{StaticResource ColorError950}" />
            <SolidColorBrush x:Key="ButtonSolidDangerBorderBrush" Color="{StaticResource ColorError700}" />
            <SolidColorBrush x:Key="ButtonSolidDangerPointeroverBorderBrush" Color="{StaticResource ColorError800}" />
            <SolidColorBrush x:Key="ButtonSolidDangerPressedBorderBrush" Color="{StaticResource ColorError950}" />
            <SolidColorBrush x:Key="ButtonSolidDisabledForeground" Color="{StaticResource ColorWarm600}" />
            <SolidColorBrush x:Key="ButtonSolidDisabledBackground" Color="{StaticResource ColorWarm200}" />
            <SolidColorBrush x:Key="ButtonSolidDisabledBorderBrush" Color="{StaticResource ColorWarm300}" />

            <!-- Botón outline -->
