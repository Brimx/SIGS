            <SolidColorBrush x:Key="DataGridRowBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DataGridRowPointeroverBackground" Color="{StaticResource ColorWarm200}" />
            <SolidColorBrush x:Key="DataGridRowSelectedBackground" Color="{StaticResource ColorBrand100}" />
            <SolidColorBrush x:Key="DataGridRowSelectedPointeroverBackground" Color="{StaticResource ColorBrand200}" />
            <SolidColorBrush x:Key="DataGridCellBackground" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridLineBrush" Color="{StaticResource ColorWarm300}" />
            <SolidColorBrush x:Key="DataGridCellFocusBorderBrush" Color="{StaticResource ColorBrand600}" />
            <SolidColorBrush x:Key="DataGridCellCurrentBorderBrush" Color="{StaticResource ColorWarm600}" />
            <SolidColorBrush x:Key="DataGridCellErrorBrush" Color="{StaticResource ColorError700}" />
            <SolidColorBrush x:Key="DataGridDisabledBackground" Color="{StaticResource ColorWarm100}" />
            <SolidColorBrush x:Key="DataGridColumnHeaderBackground" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridColumnHeaderForeground" Color="{StaticResource ColorWarm700}" />
            <SolidColorBrush x:Key="DataGridColumnHeaderPointeroverBackground" Color="{StaticResource ColorWarm200}" />
            <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackground" Color="{StaticResource ColorWarm300}" />
            <SolidColorBrush x:Key="DataGridRowErrorBackground" Color="{StaticResource ColorError50}" />
            <SolidColorBrush x:Key="DataGridDetailsPresenterBackground" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridRowGroupHeaderBackground" Color="{StaticResource ColorWarm100}" />
