            <SolidColorBrush x:Key="ComboBoxSelectorPressedBackground" Color="{StaticResource ColorWarm100}" />
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBorderBrush" Color="{StaticResource ColorBrand700}" />
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBackground" Color="{StaticResource ColorWarm100}" />
