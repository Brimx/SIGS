            <SolidColorBrush x:Key="TextBoxDisabledBackground" Color="{StaticResource ColorWarm100}" />
            <SolidColorBrush x:Key="TextBoxDisabledForeground" Color="{StaticResource ColorWarm600}" />
            <SolidColorBrush x:Key="TextBoxDisabledBorderBrush" Color="{StaticResource ColorWarm200}" />
            <SolidColorBrush x:Key="TextBoxSelectionBackground" Color="{StaticResource ColorBrand700}" />
            <SolidColorBrush x:Key="TextBoxSelectionForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextBoxBorderedDefaultBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextBoxBorderedDefaultBorderBrush" Color="{StaticResource ColorWarm300}" />
            <SolidColorBrush x:Key="TextBoxBorderedPointeroverBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextBoxBorderedPointeroverBorderBrush" Color="{StaticResource ColorWarm600}" />

            <!-- CheckBox -->
            <SolidColorBrush x:Key="CheckBoxForeground" Color="{StaticResource ColorWarm900}" />
            <SolidColorBrush x:Key="CheckBoxDisabledForeground" Color="{StaticResource ColorWarm600}" />
            <SolidColorBrush x:Key="CheckBoxGlyphFill" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxDefaultBackground" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxDefaultBorderBrush" Color="{StaticResource ColorWarm600}" />
