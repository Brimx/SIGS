# Configuración de base de datos SIGS (PostgreSQL LAN / Local)
# Si SIGS_POSTGRES_CONNECTION está definida, SIGS usará PostgreSQL con Npgsql.
# Si está vacía o no se define, SIGS usará SQLite local (~/.local/share/SIGS/sigs.db).
SIGS_POSTGRES_CONNECTION=Host=localhost;Port=5432;Database=sigs;Username=sigs_user;Password=sigs_password;
